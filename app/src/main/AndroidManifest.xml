<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 本地音频读取 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      「播放并下载」在 **Android 9 及以下**需要它才能写进公开音乐目录。
      Android 10（API 29）起走 MediaStore 插入自己的媒体文件，
      **完全不需要权限**，所以这里用 maxSdkVersion 把范围限死 ——
      新系统上它连声明都不会生效，用户不会看到这条权限。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 音频可视化：读取本应用音频会话的频谱（Visualizer 不需要录音权限） -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      联网能力，三处用途，**全部默认关闭**，只有用户在设置里显式打开才会用到：
      ① 在线歌词（LrcAPI）② 在线封面（iTunes）③ 在线音乐（搜索 + 播放）。
      三个都关着时不会发出任何请求，播放器依旧是纯本地的。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 后台播放与通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 黑胶模式的触感反馈（install-time 普通权限） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Shizuku：以 shell 身份读 B 站缓存目录（Android/data/tv.danmaku.bilibilihd）。
      Android 11+ 普通应用无法访问其他应用的 Android/data，shell 是免 root 的唯一通道。
      没有装 Shizuku 或没授权时这条权限不生效，功能会自动降级为「未就绪」提示。
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />


    <uses-feature
        android:name="android.hardware.audio.output"
        android:required="false" />

    <application
        android:name=".SonanceApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/sonance_backup_rules"
        android:dataExtractionRules="@xml/sonance_data_extraction"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:theme="@style/Theme.Sonance"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Sonance">
            <!-- 支持从文件管理器用本播放器打开音频 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          视频「锁屏 / 后台继续播放」的前台服务。
          只负责把进程钉住 + 提供媒体通知（播放/暂停、上一首/下一首、进度），
          播放器仍然只有 BiliVideoSession 里的那一个实例。
        -->
        <service
            android:name=".playback.BiliVideoService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />


        <!--
          B 站缓存的全屏播放页。
          独立 Activity 而不是在主界面里翻横屏：主界面是三档布局（手机 / 中屏 / 平板），
          跟着转会把整套侧栏和播放面板一起横过来；独立页只关心一块 Surface 和一层控制条。
        -->
        <activity
            android:name=".ui.VideoPlayerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.Sonance"
            android:supportsPictureInPicture="true" />

        <!-- Shizuku 的权限回调 provider。authorities 必须带包名前缀，不能和别的应用冲突 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!--
          把下载的封面交给通知栏 / 锁屏用的 FileProvider。

          下载的封面存在应用私有目录（files/cover_cache），系统进程读不到 File，
          而 MediaSession 只认 URI 或位图 —— 所以经这里转成 content:// URI。
          authority 与 CoverCache.contentUri 里的 "${包名}.covers" 必须一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.covers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          桌面小组件的播控 / 歌词命令入口。
          只接收本应用自己发出的显式 intent，所以不导出、也不声明 intent-filter。
          小组件不走 MediaButtonReceiver：media3 在 API 26+ 会丢掉非播放类按键。
        -->
        <receiver
            android:name=".widget.WidgetCommandReceiver"
            android:exported="false" />

        <!--
          ===== 桌面小组件：五种样式，各自是一个独立的 receiver =====

          之所以拆成五个而不是一个带参数的 provider：系统的小组件选择器是按
          `<receiver>` + `<meta-data>` 一条条列出来的，用户看到的就是五条
          「横向控制条 / 封面卡片 / 信息宽卡 / 极简横条 / 大幅卡片」，
          可以按桌面空间和喜好各挑一个。渲染逻辑全部共用基类。
        -->
        <receiver
            android:name=".widget.SonanceWidgetBar"
            android:exported="false"
            android:label="@string/widget_label_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bar_info" />
        </receiver>

        <receiver
            android:name=".widget.SonanceWidgetCard"
