<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A 占位封面：利落圆角方图（与有封面时保持一致），内衬微弱玻璃边框与音符标记。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF1B1E26"
                android:startColor="#FF2D313D"
                android:type="linear" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/widget_ic_note"
        android:gravity="center"
        android:width="22dp"
        android:height="22dp" />
</layer-list>
