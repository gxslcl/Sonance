<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A 小组件预览底：克制深色烟熏磨砂玻璃 + 22dp 圆角 + 内敛 1dp 玻璃边。
  刚拖放上去或桌面选择器预览时使用，真正刷新后由 WidgetRenderer 绘制封面氛围底图替换。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#EB20232B"
        android:endColor="#F2161920"
        android:startColor="#E8282C36"
        android:type="linear" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
