<?xml version="1.0" encoding="utf-8"?>
<!--
  让在线音频能用明文 HTTP 下载。

  ## 为什么需要它

  从 Android 9（API 28）起，明文 HTTP **默认被系统禁止**
  （`usesCleartextTraffic` 的默认值变成 false）。在线音源有两类明文流量：

  1. 网易云取流 302 到 `http://m701.music.126.net/...` —— 不放行的话
     重定向直接失败，错误码 ERROR_CODE_IO_CLEARTEXT_NOT_PERMITTED，
     表现是"所有在线歌都播不了"。
  2. **插件源**（内容源插件）自己声明的接口和媒体地址也是明文：
     - kg.js 的后端 `http://ws.suol.cc/kg/kg.php`（搜索/取流都走它）；
     - 酷狗 CDN `http://fs.youthandroid2.kugou.com/...`（播放地址）和
       `http://imge.kugou.com/...`（封面）。实测酷狗媒体机的 https
       证书是坏的（CERT_ALTNAME_INVALID），想 https 都升不上去，
       只能放行明文。

  ## 为什么不用 android:usesCleartextTraffic="true"

  那个开关是**全局**的，等于给整个应用开明文。这里逐域名放行，
  其余一律维持系统的默认禁止。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 网易云音频 CDN（带子域，覆盖 m701/m801 等按节点编号的下载机） -->
        <domain includeSubdomains="true">music.126.net</domain>
        <!-- 内容源插件的后端与媒体域名：kg.js（酷狗概念版中转） -->
        <domain includeSubdomains="true">ws.suol.cc</domain>
        <domain includeSubdomains="true">kugou.com</domain>
    </domain-config>
</network-security-config>
