<?xml version="1.0" encoding="utf-8"?>
<!--
  让在线音频能用明文 HTTP 下载。

  ## 为什么需要它

  从 Android 9（API 28）起，明文 HTTP **默认被系统禁止**
  （`usesCleartextTraffic` 的默认值变成 false）。在线音源有两类明文流量：

  1. 网易云取流 302 到 `http://m701.music.126.net/...` —— 不放行的话
     重定向直接失败，错误码 ERROR_CODE_IO_CLEARTEXT_NOT_PERMITTED，
     表现是"所有在线歌都播不了"。
  2. **插件源**（内容源插件）自己声明的接口和媒体地址也是明文：
     - kg.js 的后端 `http://ws.suol.cc/kg/kg.php`（搜索/取流都走它）；
     - 酷狗 CDN `http://fs.youthandroid2.kugou.com/...`（播放地址）和
       `http://imge.kugou.com/...`（封面）。实测酷狗媒体机的 https
       证书是坏的（CERT_ALTNAME_INVALID），想 https 都升不上去，
       只能放行明文。

  ## 为什么 base-config 也放开了（而不是只写白名单）

  早期是逐域名放行的，其余维持系统默认禁止。加入 D-LAN（DLNA / UPnP）后这条走不通：
  媒体服务器与本机回连地址都是 `http://<局域网动态 IP>:<端口>/...`，设备 IP 无法预先通过
  `domain-config` 枚举，只能把 `base-config` 打开。

  ## 代价与现状

  - 这等价于对整个应用放行明文 HTTP，所以下面那份域名白名单现在只是**记录性质**
    （说明哪些第三方域名本来就依赖明文），不再承担拦截作用。
  - 仍然是 `usesCleartextTraffic` 之外的做法：今后若要收紧，只能靠「DLNA 会话期间临时放行」
    这类运行时手段，单纯改回逐域名白名单会让投屏失效。
-->
<network-security-config>
    <!-- D-LAN (DLNA / UPnP) 需要访问局域网内任意动态 IP 的 HTTP 设备描述、SOAP 控制和音频流，
         设备 IP 无法预先通过 domain-config 枚举，因此允许标准明文 HTTP 流量。 -->
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 网易云音频 CDN（带子域，覆盖 m701/m801 等按节点编号的下载机） -->
        <domain includeSubdomains="true">music.126.net</domain>
        <!-- 内容源插件的后端与媒体域名：kg.js（酷狗概念版中转） -->
        <domain includeSubdomains="true">ws.suol.cc</domain>
        <domain includeSubdomains="true">kugou.com</domain>
    </domain-config>
</network-security-config>
