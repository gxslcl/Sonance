<?xml version="1.0" encoding="utf-8"?>
<!--
  大幅卡片 · 5x4
  minWidth/minHeight 是老系统（API < 31）唯一的尺寸声明方式，按 70dp/格 换算；
  targetCellWidth/Height 是 Android 12+ 的精确格数，新系统优先用它。
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_desc_large"
    android:initialLayout="@layout/widget_large"
    android:minHeight="280dp"
    android:minWidth="400dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="4"
    android:targetCellWidth="5"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
