<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份 / 换机迁移规则（对应 manifest 的 dataExtractionRules）。

  和 sonance_backup_rules.xml 同一条理由：网易云账号凭证不进云备份、也不跟着换机搬家。
  换机后重新扫码登录即可，代价很小；把登录态带过去则不值得。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sonance_netease_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sonance_netease_account.xml" />
    </device-transfer>
</data-extraction-rules>
