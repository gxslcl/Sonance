<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 3 · 信息宽卡 5x2（酷狗概念版复刻）

  左侧：发光彩胶唱片（106dp × 106dp）；
  右侧：
    - 上层：歌名 + 歌手（或全宽完整三行歌词，当前行最多 2 行自动换行）+ 右上角红心收藏键；
    - 中层：左侧当前时间 + 细白圆角进度条 + 右侧总时长；
    - 下层：5 枚纯白播控图标均匀铺开（播放模式、上一首、播放/暂停、下一首、歌词切换）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 上层：歌名/歌手 或 完整歌词 + 右上角红心收藏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_info_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:shadowColor="#26000000"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:text="@string/widget_idle_title"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_idle_subtitle"
                            android:textColor="#CCFFFFFF"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_lyric_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/widget_lyric_prev"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#99FFFFFF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/widget_lyric_cur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:shadowColor="#26000000"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="#FFFFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/widget_lyric_next"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#99FFFFFF"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </FrameLayout>

                <ImageView
                    android:id="@+id/widget_fav"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="top"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_fav_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_heart_outline" />
            </LinearLayout>

            <!-- 中层：真实进度条 -->
            <LinearLayout
                android:id="@+id/widget_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_cur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/widget_progress"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#E6FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 下层：5 枚播控图标均匀排布 -->
            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_mode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_mode_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_mode_shuffle" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_prev_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_prev" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_play_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_next_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_next" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_lyric_toggle"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_lyric_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_lyric" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
