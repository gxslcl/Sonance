<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 3 · 信息宽条（4x1）
  横向铺开，信息给得最多：封面、歌名、歌手、上一首/播放/下一首、打开应用。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@string/widget_cover_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn"
        android:contentDescription="@string/widget_prev_desc"
        android:padding="8dp"
        android:src="@drawable/widget_ic_prev" />

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn_accent"
        android:contentDescription="@string/widget_play_desc"
        android:padding="10dp"
        android:src="@drawable/widget_ic_play" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_btn"
        android:contentDescription="@string/widget_next_desc"
        android:padding="8dp"
        android:src="@drawable/widget_ic_next" />

    <ImageView
        android:id="@+id/widget_open"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/widget_open_desc"
        android:padding="9dp"
        android:src="@drawable/widget_ic_open" />
</LinearLayout>
