<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 保留 5 列样式 4：信息宽卡 5×2
  左：114dp 大圆角方图封面（唯一视觉主角）；
  右：上层歌名/歌手（或歌词）+ 收藏/词，中间圆点进度条，下层 5 枚平衡控件与 HQ 标识。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="13dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 顶层：信息/歌词 + 收藏/歌词切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_info_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_idle_title"
                            android:textColor="#F5FFFFFF"
                            android:textSize="15.5sp" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_idle_subtitle"
                            android:textColor="#ABFFFFFF"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_lyric_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/widget_lyric_prev"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#78FFFFFF"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/widget_lyric_cur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="#F5FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/widget_lyric_next"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_fav"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@drawable/widget_btn_ripple"
                        android:contentDescription="@string/widget_fav_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_ic_heart_outline" />

                    <ImageView
                        android:id="@+id/widget_lyric_toggle"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_btn_ripple"
                        android:contentDescription="@string/widget_lyric_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_ic_lyric" />
                </LinearLayout>
            </LinearLayout>

            <!-- 中层：真实带圆点细进度条 -->
            <LinearLayout
                android:id="@+id/widget_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_cur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="@string/widget_time_zero"
                    android:textColor="#ABFFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/widget_progress"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="#ABFFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 下层：模式 + 上曲 + 圆形实心播放 + 下曲 + HQ -->
            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_mode"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_mode_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_mode_shuffle" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_prev_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_prev" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_play_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_next_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_next" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@id/widget_hq_badge"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="HQ"
                    android:textColor="#6EFFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
