<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 5 · 大幅卡片 5x4（酷狗概念版复刻）

  - 顶栏：左上角圆角徽标 + 「山水有清音」，右上角红心收藏键；
  - 中部：大号立体果冻发光彩胶唱片（weight=1 自适应缩放）；
  - 下部信息/歌词区：默认居中展示「歌名-歌手」（Girlfriend-Charlie Puth）；
    开启歌词后，展开为全宽三行歌词（当前行最多 2 行自动换行，唱片自动礼让高度）；
  - 进度行：当前时间 + 细白圆角进度条 + 总时长；
  - 底栏：5 枚纯白播控键全宽均匀分布（播放模式、上一首、播放/暂停、下一首、歌词切换）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- 顶栏：左上品牌徽标 + 右上红心收藏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_brand_badge" />

            <TextView
                android:id="@+id/widget_brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/widget_brand"
                android:textColor="#D9FFFFFF"
                android:textSize="11.5sp" />

            <ImageView
                android:id="@+id/widget_fav"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_fav_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_heart_outline" />
        </LinearLayout>

        <!-- 居中大号发光彩胶唱片（开启歌词时自动按剩余高度平滑缩放） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_cover_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_placeholder" />
        </FrameLayout>

        <!-- 歌曲名 / 完整三行歌词区（wrap_content 让三行双折行歌词绝不被截断） -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="32dp">

            <LinearLayout
                android:id="@+id/widget_info_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#26000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="@string/widget_idle_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_lyric_prev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_lyric_cur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:shadowColor="#26000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/widget_lyric_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 进度条行 -->
        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#E6FFFFFF"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/widget_progress"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#E6FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 底栏 5 枚播控键全宽均匀分布 -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/widget_mode"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_mode_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_mode_shuffle" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_prev_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyric_toggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_lyric_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_lyric" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
