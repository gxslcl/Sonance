<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 保留 5 列样式 5：大幅卡片 5×4
  - 顶栏：胶囊品牌徽标「山水有清音」 + 右上收藏胶囊；
  - 主舞台：常态居中 124dp 圆角方图封面 + 歌名歌手；歌词态平滑切为顶部磨砂歌曲栏 + 居中三行歌词；
  - 底部：圆点进度条 + 5 枚均匀播控（含 44dp 高对比实心播放键）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@id/widget_brand_pill_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@id/widget_brand_dot"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_brand"
                    android:textColor="#ABFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_fav"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_fav_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_heart_outline" />
        </LinearLayout>

        <!-- 中央舞台：常态 / 歌词态互斥切换 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 常态：居中大圆角方图封面 + 歌名 + 歌手 -->
            <LinearLayout
                android:id="@+id/widget_info_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:contentDescription="@string/widget_cover_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_placeholder" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_title"
                    android:textColor="#F5FFFFFF"
                    android:textSize="16.5sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#ABFFFFFF"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 歌词态：顶部磨砂歌曲胶囊条 + 居中三行歌词 -->
            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@id/widget_lyric_header_wrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_card_inner_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="9dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:id="@id/widget_cover_mini"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/widget_cover_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@id/widget_lyric_song_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#F5FFFFFF"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@id/widget_lyric_song_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#ABFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_lyric_prev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_lyric_cur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="7dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#F5FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/widget_lyric_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 进度条 -->
        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="@string/widget_time_zero"
                android:textColor="#ABFFFFFF"
                android:textSize="10.5sp" />

            <ImageView
                android:id="@+id/widget_progress"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="#ABFFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- 底部 5 枚均匀控件 -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/widget_mode"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_mode_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_mode_shuffle" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_prev_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyric_toggle"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_lyric_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_lyric" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
