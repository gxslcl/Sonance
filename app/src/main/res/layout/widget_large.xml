<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 5 · 大幅卡片（5x2）
  左边大封面，右边标题 / 艺术家 + 三键 + 打开应用。
  5 格宽才放得下"封面和信息并排"，2x2 那种竖排在这个尺寸上会显得空。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:contentDescription="@string/widget_cover_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1.15"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_prev_desc"
                android:padding="8dp"
                android:src="@drawable/widget_ic_prev" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_btn_accent"
                android:contentDescription="@string/widget_play_desc"
                android:padding="10dp"
                android:src="@drawable/widget_ic_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_btn"
                android:contentDescription="@string/widget_next_desc"
                android:padding="8dp"
                android:src="@drawable/widget_ic_next" />

            <ImageView
                android:id="@+id/widget_open"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/widget_open_desc"
                android:src="@drawable/widget_ic_open" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
