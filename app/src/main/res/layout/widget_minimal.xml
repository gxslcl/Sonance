<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 4 · 极简文字（2x1）
  完全不放封面图 —— 省内存、不吃 Binder 传输，适合只想要"看到歌名 + 能暂停"的人。
  左侧一条强调色竖条代替封面，保持视觉重心。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_solid"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <View
        android:layout_width="3dp"
        android:layout_height="30dp"
        android:background="@color/widget_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_title"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_subtitle"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_play"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_accent"
        android:contentDescription="@string/widget_play_desc"
        android:padding="9dp"
        android:src="@drawable/widget_ic_play" />
</LinearLayout>
