<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desktop_lyrics_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 歌词文本容器 -->
    <LinearLayout
        android:id="@+id/desktop_lyrics_text_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 当前歌词 -->
        <TextView
            android:id="@+id/tv_lyric_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="340dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="山水有清音 桌面歌词"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:gravity="center" />

        <!-- 次行歌词 / 歌曲信息 -->
        <TextView
            android:id="@+id/tv_lyric_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxWidth="340dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            android:shadowColor="#D9000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 快捷播控面板（点击展开，锁定或超时后自动折叠） -->
    <LinearLayout
        android:id="@+id/desktop_lyrics_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/desktop_lyrics_controls_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- 上一首 -->
        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/widget_ic_prev"
            android:contentDescription="上一首" />

        <!-- 播放/暂停 -->
        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/widget_ic_play"
            android:contentDescription="播放暂停" />

        <!-- 下一首 -->
        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/widget_ic_next"
            android:contentDescription="下一首" />

        <!-- 分隔竖线 -->
        <View
            android:id="@+id/controls_divider"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#33FFFFFF" />

        <!-- 背景样式切换（无背景 / 浅色半透明 / 深色半透明） -->
        <ImageButton
            android:id="@+id/btn_bg_style"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/ic_dl_palette"
            android:contentDescription="背景样式" />

        <!-- 字号切换 -->
        <ImageButton
            android:id="@+id/btn_font_size"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/ic_dl_text_size"
            android:contentDescription="字号" />

        <!-- 锁定 -->
        <ImageButton
            android:id="@+id/btn_lock"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/ic_dl_lock"
            android:contentDescription="锁定" />

        <!-- 关闭 -->
        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/desktop_lyrics_btn_bg"
            android:src="@drawable/ic_dl_close"
            android:contentDescription="关闭" />
    </LinearLayout>
</LinearLayout>
