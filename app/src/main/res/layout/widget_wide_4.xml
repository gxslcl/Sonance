<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 新增 4 列样式 4：信息宽卡 4×2
  左：98dp 圆角方图封面（4列下留出更充裕的右边文字与进度空间）；右：信息/歌词 + 进度 + 播控。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="98dp"
            android:layout_height="98dp"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/widget_info_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_idle_title"
                            android:textColor="#F5FFFFFF"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/widget_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2.5dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/widget_idle_subtitle"
                            android:textColor="#ABFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widget_lyric_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/widget_lyric_prev"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#78FFFFFF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/widget_lyric_cur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="#F5FFFFFF"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/widget_lyric_next"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_fav"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/widget_btn_ripple"
                        android:contentDescription="@string/widget_fav_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_ic_heart_outline" />

                    <ImageView
                        android:id="@+id/widget_lyric_toggle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="2dp"
                        android:background="@drawable/widget_btn_ripple"
                        android:contentDescription="@string/widget_lyric_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_ic_lyric" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_progress_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_time_cur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:text="@string/widget_time_zero"
                    android:textColor="#ABFFFFFF"
                    android:textSize="9.5sp" />

                <ImageView
                    android:id="@+id/widget_progress"
                    android:layout_width="0dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="#ABFFFFFF"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_mode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_mode_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_mode_shuffle" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_prev_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_prev" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_play_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_next_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_next" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@id/widget_hq_badge"
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="HQ"
                    android:textColor="#6EFFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
