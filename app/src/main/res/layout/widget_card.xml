<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 保留 5 列样式 3：封面卡片 3×2
  - 常态：左上角 60dp 圆角方图封面 + 右上并排收藏/词胶囊，中间歌名与歌手，底部胶囊播放键；
  - 歌词态：顶部保留小封面+歌名不丢失专辑主视觉，中区展示双行清晰歌词。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 常态：圆角封面 + 歌名歌手 -->
            <LinearLayout
                android:id="@+id/widget_info_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="start"
                    android:contentDescription="@string/widget_cover_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_placeholder" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_title"
                    android:textColor="#F5FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#ABFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 歌词态：小封面标题头（避开右上角双胶囊） + 居中歌词区 -->
            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="60dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@id/widget_cover_mini"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/widget_cover_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@id/widget_lyric_song_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#F5FFFFFF"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@id/widget_lyric_song_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1.5dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#ABFFFFFF"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_lyric_prev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/widget_lyric_cur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#F5FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_lyric_next"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 底部三枚播控：上曲 + 胶囊播放按钮 + 下曲 -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_prev_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="56dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角并排双胶囊：收藏 + 歌词切换 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_fav"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_btn_ripple"
            android:contentDescription="@string/widget_fav_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_heart_outline" />

        <ImageView
            android:id="@+id/widget_lyric_toggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_btn_ripple"
            android:contentDescription="@string/widget_lyric_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_lyric" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_time_cur"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
</FrameLayout>
