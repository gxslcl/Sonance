<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 2 · 封面卡片（2x2）
  封面占大头，信息与三键控制在下方。视觉上最"像播放器"的一套。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_cover_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_placeholder" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_title"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_idle_subtitle"
        android:textColor="@color/widget_text_dim"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_prev_desc"
            android:padding="8dp"
            android:src="@drawable/widget_ic_prev" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/widget_btn_accent"
            android:contentDescription="@string/widget_play_desc"
            android:padding="10dp"
            android:src="@drawable/widget_ic_play" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="@string/widget_next_desc"
            android:padding="8dp"
            android:src="@drawable/widget_ic_next" />
    </LinearLayout>
</LinearLayout>
