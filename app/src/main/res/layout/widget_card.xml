<?xml version="1.0" encoding="utf-8"?>
<!--
  样式 2 · 封面卡片 3x2（酷狗概念版复刻）

  常规态（默认）：
    - 上半部：超大发光彩胶唱片（轻微向上出血展现饱满视觉）；
    - 中部：居中歌名（Marry Me）；
    - 底部：红心收藏、播放/暂停、下一首 三枚大号图标居中排列，右上角附带精巧歌词切换键。
  歌词态（开启歌词后）：
    - 自动隐藏大唱片，把整张卡片中上部完全让给三行居中歌词（当前行最多 2 行自动换行），
      整句长歌词清晰完整呈现。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- 唱片 + 歌词舞台共用自适应权重区 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="-6dp"
                android:contentDescription="@string/widget_cover_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_placeholder" />

            <!-- 开启歌词时占满上方全部空间，完整展示三行歌词 -->
            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingTop="14dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/widget_lyric_prev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/widget_lyric_cur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:shadowColor="#26000000"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14.5sp" />

                <TextView
                    android:id="@+id/widget_lyric_next"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 居中歌名（常规态显示，歌词态自动隐藏） -->
        <LinearLayout
            android:id="@+id/widget_info_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#26000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/widget_idle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 底部三枚核心图标：红心居左、播放/暂停居中、下一首居右，全宽均匀分布（酷狗概念版 3x2） -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/widget_fav"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_fav_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_heart_outline" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角精巧歌词切换键 -->
    <ImageView
        android:id="@+id/widget_lyric_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/widget_btn_ripple"
        android:contentDescription="@string/widget_lyric_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ic_lyric" />

    <!-- 隐藏占位 id（供统一渲染寻址） -->
    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_prev"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_time_cur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <ImageView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
