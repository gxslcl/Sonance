<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 新增 4 列样式 3：封面方卡 2×2
  专为 4 列半行正方形打造：54dp 封面 + 右上纵向叠放收藏/词胶囊（防窄屏拥挤）+ 46dp 胶囊播放键。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="11dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 常态 -->
            <LinearLayout
                android:id="@+id/widget_info_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start"
                    android:contentDescription="@string/widget_cover_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_placeholder" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_title"
                    android:textColor="#F5FFFFFF"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#ABFFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- 歌词态（右留 32dp 避开纵向角标） -->
            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="30dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@id/widget_cover_mini"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:contentDescription="@string/widget_cover_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@id/widget_lyric_song_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#F5FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@id/widget_lyric_song_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#ABFFFFFF"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_lyric_prev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/widget_lyric_cur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#F5FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/widget_lyric_next"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 底部播控：紧致胶囊 -->
        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_prev_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="46dp"
                android:layout_height="27dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右上角纵向紧致堆叠：收藏 + 歌词切换 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_fav"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/widget_btn_ripple"
            android:contentDescription="@string/widget_fav_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_heart_outline" />

        <ImageView
            android:id="@+id/widget_lyric_toggle"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_btn_ripple"
            android:contentDescription="@string/widget_lyric_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_ic_lyric" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_time_cur"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <ImageView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="0dp"
            android:layout_height="0dp" />
    </LinearLayout>
</FrameLayout>
