<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 新增 4 列样式 5：大幅卡片 4×4
  适配 4 列满屏宽度（minWidth 240dp）：114dp 居中圆角方图封面 + 歌词平滑切换 + 底部 5 键。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="13dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@id/widget_brand_pill_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3.5dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3.5dp">

                <ImageView
                    android:id="@id/widget_brand_dot"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_brand"
                    android:textColor="#ABFFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_fav"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_fav_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_heart_outline" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/widget_info_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_cover"
                    android:layout_width="114dp"
                    android:layout_height="114dp"
                    android:contentDescription="@string/widget_cover_desc"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_placeholder" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_title"
                    android:textColor="#F5FFFFFF"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_idle_subtitle"
                    android:textColor="#ABFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_lyric_group"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@id/widget_lyric_header_wrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_card_inner_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@id/widget_cover_mini"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@string/widget_cover_desc"
                        android:scaleType="fitCenter"
                        android:src="@drawable/widget_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@id/widget_lyric_song_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#F5FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@id/widget_lyric_song_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="#ABFFFFFF"
                            android:textSize="10.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_lyric_prev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/widget_lyric_cur"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textColor="#F5FFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/widget_lyric_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_horizontal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#78FFFFFF"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_cur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="@string/widget_time_zero"
                android:textColor="#ABFFFFFF"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/widget_progress"
                android:layout_width="0dp"
                android:layout_height="10dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/widget_time_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="#ABFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/widget_mode"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_mode_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_mode_shuffle" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_prev_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_play_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_next_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_lyric_toggle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_btn_ripple"
                android:contentDescription="@string/widget_lyric_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_lyric" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
