<?xml version="1.0" encoding="utf-8"?>
<!--
  STYLE A · 保留 5 列样式 2：横向控制条 5×1（两排）
  左：圆角方图封面（跨两排）；
  右上排：歌名 + 歌手（或单行歌词），不再与按钮挤同一行；
  右下排：红心 + 上一首 + 高对比圆形播放键 + 下一首 + 歌词开关；
  底缘：2.5dp 贴边实时细进度条。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_clip_bg_dark"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- 第一排：歌曲信息 / 歌词 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/widget_info_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_idle_title"
                        android:textColor="#F5FFFFFF"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:maxWidth="120dp"
                        android:text="@string/widget_idle_subtitle"
                        android:textColor="#ABFFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_lyric_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/widget_lyric_prev"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_lyric_cur"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#F5FFFFFF"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/widget_lyric_next"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- 第二排：播控按钮 -->
            <LinearLayout
                android:id="@+id/widget_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_fav"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_fav_desc"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_heart_outline" />

                <ImageView
                    android:id="@+id/widget_prev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_prev_desc"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_prev" />

                <ImageView
                    android:id="@+id/widget_play"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_play_desc"
                    android:padding="2dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_play" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_next_desc"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_next" />

                <ImageView
                    android:id="@+id/widget_lyric_toggle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/widget_btn_ripple"
                    android:contentDescription="@string/widget_lyric_desc"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_ic_lyric" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底缘贴边细进度线 -->
    <LinearLayout
        android:id="@+id/widget_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_time_cur"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/widget_time_total"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mode"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</FrameLayout>
